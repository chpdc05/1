hadoop jar /usr/lib/hadoop-mapreduce/hadoop-streaming.jar -input /user/cloudera/prg1/word.txt -output /user/cloudera/prg1/output -mapper /home/cloudera/mapper.py -reducer /home/cloudera/reducer.py
echo "===== HADOOP OUTPUT ====="
hdfs dfs -cat /user/cloudera/prg1/output/part-00000
EOF

